#include <winres.h>

#define VER_FILEVERSION              1,0,0,0
#define VER_FILEVERSION_STR         "1.0.0.0"

#define VER_PRODUCTVERSION           1,0,0,0
#define VER_PRODUCTVERSION_STR      "1.0.0.0"

#define VER_COMPANYNAME_STR         "Universal Manager Project"
#define VER_FILEDESCRIPTION_STR     "Scripting & Generator Runtime Framework"
#define VER_INTERNALNAME_STR        "Avalonium.dll"
#define VER_LEGALCOPYRIGHT_STR      "Copyright (C) 2026 Universal Manager Project."
#define VER_ORIGINALFILENAME_STR    "Avalonium.dll"
#define VER_PRODUCTNAME_STR         "Avalonium"
#define VER_LEGALTRADEMARKS_STR     "Unreal Engine is a trademark of Epic Games, Inc."

#ifndef NDEBUG
#define VER_DEBUG                   VS_FF_DEBUG
#else
#define VER_DEBUG                   0
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_FILEVERSION
PRODUCTVERSION  VER_PRODUCTVERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       VER_DEBUG
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
BLOCK "StringFileInfo"
BEGIN
BLOCK "040904E4" // US English, Windows Multilingual (CP1252)
BEGIN
VALUE "CompanyName", VER_COMPANYNAME_STR
VALUE "FileDescription", VER_FILEDESCRIPTION_STR
VALUE "FileVersion", VER_FILEVERSION_STR
VALUE "InternalName", VER_INTERNALNAME_STR
VALUE "LegalCopyright", VER_LEGALCOPYRIGHT_STR
VALUE "OriginalFilename", VER_ORIGINALFILENAME_STR
VALUE "ProductName", VER_PRODUCTNAME_STR
VALUE "ProductVersion", VER_PRODUCTVERSION_STR
VALUE "LegalTrademarks", VER_LEGALTRADEMARKS_STR
END
END

BLOCK "VarFileInfo"
BEGIN
VALUE "Translation", 0x409, 1252
END
END