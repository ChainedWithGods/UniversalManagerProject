<UserControl
    x:Class="PakViewer.Views.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:PakViewer.Settings"
    xmlns:converters="using:PakViewer.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>

        <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="Settings"
                           FontSize="28"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Click="CloseButton_Click"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTipService.ToolTip="Close settings">
                <FontIcon Glyph="&#xE711;" FontSize="14"/>
            </Button>
        </Grid>

        <Border Grid.Row="1"
                Height="1"
                Margin="0,0,0,20"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top navigation tabs -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,20">
                <Button x:Name="GeneralTabButton"
                        Click="GeneralTab_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="14"/>
                        <TextBlock Text="General"/>
                    </StackPanel>
                </Button>
                
                <Button x:Name="ProfilesTabButton"
                        Click="ProfilesTab_Click"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE77B;" FontSize="14"/>
                        <TextBlock Text="Profiles"/>
                    </StackPanel>
                </Button>
                
                <Button x:Name="ShortcutsTabButton"
                        Click="ShortcutsTab_Click"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE92E;" FontSize="14"/>
                        <TextBlock Text="Shortcuts"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Content area -->
            <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsGeneralSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="General"
                                       FontSize="24"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Shape the look and feel of the application."
                                       FontSize="13"
                                       Opacity="0.68"/>
                        </StackPanel>

                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="18"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <Grid Padding="18,18,18,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Theme" FontWeight="SemiBold"/>
                                        <TextBlock Text="Apply your preferred appearance."
                                                   FontSize="11"
                                                   Opacity="0.64"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeComboBox"
                                              Grid.Column="1"
                                              MinWidth="170"
                                              ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                                              SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                                              SelectionChanged="ThemeComboBox_SelectionChanged"/>
                                </Grid>

                                <Grid Padding="18,0,18,18" ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="8" HorizontalAlignment="Center">
                                        <Border x:Name="SystemPreviewCard"
                                                Tag="System"
                                                Tapped="ThemePreview_Tapped"
                                                CornerRadius="14"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                Width="168"
                                                Height="112">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="22"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Background="#E7ECF5" Grid.Row="0">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0">
                                                            <Ellipse Width="6" Height="6" Fill="#93A0B5" VerticalAlignment="Center"/>
                                                            <Ellipse Width="6" Height="6" Fill="#93A0B5" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Background="#F8FAFD" Grid.Row="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="#E3E8F2" Grid.Column="0"/>
                                                        <Grid Grid.Column="1" Margin="6,8">
                                                            <Rectangle Height="8" Fill="#D5DCEC" RadiusX="3" RadiusY="3" VerticalAlignment="Top"/>
                                                            <Rectangle Height="8" Fill="#D5DCEC" RadiusX="3" RadiusY="3" Margin="0,14,0,0" VerticalAlignment="Top"/>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>

                                                <Grid Grid.Column="1">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="22"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Background="#1B1F2A" Grid.Row="0">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0,8,0" HorizontalAlignment="Right">
                                                            <Ellipse Width="6" Height="6" Fill="#6C758A" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Background="#0F131B" Grid.Row="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="20"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0" Margin="6,8">
                                                            <Rectangle Height="8" Fill="#2A303F" RadiusX="3" RadiusY="3" VerticalAlignment="Top"/>
                                                            <Rectangle Height="8" Fill="#2A303F" RadiusX="3" RadiusY="3" Margin="0,14,0,0" VerticalAlignment="Top"/>
                                                        </Grid>
                                                        <Border Background="#252A36" Grid.Column="1"/>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <RadioButton x:Name="SystemThemeRadio"
                                                     Content="System"
                                                     GroupName="ThemeGroup"
                                                     Checked="ThemeRadio_Checked"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Center">
                                        <Border x:Name="LightPreviewCard"
                                                Tag="Light"
                                                Tapped="ThemePreview_Tapped"
                                                CornerRadius="14"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                Width="168"
                                                Height="112">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Grid Background="#E7ECF5" Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0">
                                                        <Ellipse Width="6" Height="6" Fill="#93A0B5" VerticalAlignment="Center"/>
                                                        <Ellipse Width="6" Height="6" Fill="#93A0B5" VerticalAlignment="Center"/>
                                                        <Ellipse Width="6" Height="6" Fill="#93A0B5" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Background="#F8FAFD" Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="#E3E8F2" Grid.Column="0"/>
                                                    <Grid Grid.Column="1" Margin="8">
                                                        <Rectangle Height="10" Fill="#D5DCEC" RadiusX="3" RadiusY="3"/>
                                                        <Rectangle Height="10" Fill="#D5DCEC" RadiusX="3" RadiusY="3" Margin="0,18,40,0" VerticalAlignment="Top"/>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <RadioButton x:Name="LightThemeRadio"
                                                     Content="Light"
                                                     GroupName="ThemeGroup"
                                                     Checked="ThemeRadio_Checked"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="8" HorizontalAlignment="Center">
                                        <Border x:Name="DarkPreviewCard"
                                                Tag="Dark"
                                                Tapped="ThemePreview_Tapped"
                                                CornerRadius="14"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                Width="168"
                                                Height="112">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="22"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Grid Background="#1B1F2A" Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0">
                                                        <Ellipse Width="6" Height="6" Fill="#6C758A" VerticalAlignment="Center"/>
                                                        <Ellipse Width="6" Height="6" Fill="#6C758A" VerticalAlignment="Center"/>
                                                        <Ellipse Width="6" Height="6" Fill="#6C758A" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Background="#0F131B" Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="#1D2433" Grid.Column="0"/>
                                                    <Grid Grid.Column="1" Margin="8">
                                                        <Rectangle Height="10" Fill="#2A3242" RadiusX="3" RadiusY="3"/>
                                                        <Rectangle Height="10" Fill="#2A3242" RadiusX="3" RadiusY="3" Margin="0,18,40,0" VerticalAlignment="Top"/>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <RadioButton x:Name="DarkThemeRadio"
                                                     Content="Dark"
                                                     GroupName="ThemeGroup"
                                                     Checked="ThemeRadio_Checked"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="18"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <Grid Padding="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="System sounds" FontWeight="SemiBold"/>
                                        <TextBlock Text="Enable UI sound effects while navigating the app."
                                                   FontSize="11"
                                                   Opacity="0.64"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  IsOn="{x:Bind ViewModel.SystemSoundsEnabled, Mode=TwoWay}"
                                                  Toggled="SystemSoundsToggle_Toggled"/>
                                </Grid>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <Grid x:Name="StartupBehaviorGrid" Padding="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Startup behavior" FontWeight="SemiBold"/>
                                        <TextBlock Text="Automatically load the last active profile when the app launches."
                                                   FontSize="11"
                                                   Opacity="0.64"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  IsOn="{x:Bind ViewModel.AutoLoadLastProfile, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="18"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid Padding="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Automatic updates" FontWeight="SemiBold"/>
                                    <TextBlock Text="Automatically check for application updates and new features."
                                               FontSize="11"
                                               Opacity="0.64"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Button Click="CheckForUpdatesButton_Click"
                                            Padding="14,6"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE895;" FontSize="13"/>
                                            <TextBlock Text="Check for Updates"/>
                                        </StackPanel>
                                    </Button>
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.CheckForUpdatesOnStartup, Mode=TwoWay}"
                                                  Margin="0,0,-8,0"
                                                  VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer VerticalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsProfilesSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Profiles"
                                       FontSize="24"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Configure how each game profile is loaded."
                                       FontSize="13"
                                       Opacity="0.68"/>
                        </StackPanel>

                        <!-- Single wide card containing everything -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="18"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Padding="18">
                            <StackPanel Spacing="18">
                                
                                <!-- Profile selector and management buttons -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <ComboBox Grid.Column="0"
                                              x:Name="GameSelectorComboBox"
                                              ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              PlaceholderText="Select a profile..."
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="GameSelectorComboBox_SelectionChanged"/>
                                    
                                    <Button Grid.Column="1"
                                            Click="AddProfile_Click"
                                            ToolTipService.ToolTip="Add new profile">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                            <TextBlock Text="Add"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button Grid.Column="2"
                                            Click="RemoveProfile_Click"
                                            IsEnabled="{Binding SelectedGame, Converter={StaticResource NullToBoolConverter}, Mode=OneWay}"
                                            ToolTipService.ToolTip="Remove selected profile">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE738;" FontSize="12"/>
                                            <TextBlock Text="Remove"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- Profile configuration fields - 2 columns -->
                                <Grid ColumnSpacing="18" RowSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Game name and UE version -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Game name" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                                        <TextBox PlaceholderText="Whatever"
                                                 Text="{x:Bind ViewModel.SelectedGame.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                                                 IsEnabled="{Binding SelectedGame, Converter={StaticResource NullToBoolConverter}, Mode=OneWay}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="UE Versions" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                                        <ComboBox x:Name="UeVersionComboBox"
                                                  PlaceholderText="Select or type a version"
                                                  IsEnabled="{Binding SelectedGame, Converter={StaticResource NullToBoolConverter}, Mode=OneWay}"
                                                  IsEditable="True"
                                                  ItemsSource="{x:Bind ViewModel.UeVersions, Mode=OneWay}"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="UeVersionComboBox_SelectionChanged"
                                                  LostFocus="UeVersionComboBox_LostFocus"
                                                  Loaded="UeVersionComboBox_Loaded"
                                                  TextSubmitted="UeVersionComboBox_TextSubmitted"/>
                                    </StackPanel>

                                    <!-- Row 1: PAK path -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                                        <TextBlock Text="Paks Directory" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     PlaceholderText="Path to game folder or PAK folder"
                                                     Text="{x:Bind ViewModel.SelectedGame.PakPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                                                     IsEnabled="{Binding SelectedGame, Converter={StaticResource NullToBoolConverter}, Mode=OneWay}"/>
                                            <Button Grid.Column="1"
                                                    Click="BrowsePakFolder_Click"
                                                    IsEnabled="{Binding SelectedGame, Converter={StaticResource NullToBoolConverter}, Mode=OneWay}"
                                                    ToolTipService.ToolTip="Browse for folder">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Row 2: USMAP path and AES key -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Mapping File Path" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     PlaceholderText=".usmap file path"
                                                     Text="{x:Bind ViewModel.SelectedGame.UsmapPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                                                     IsEnabled="{Binding SelectedGame, Converter={StaticResource NullToBoolConverter}, Mode=OneWay}"/>
                                            <Button Grid.Column="1"
                                                    Click="BrowseUsmapFile_Click"
                                                    IsEnabled="{Binding SelectedGame, Converter={StaticResource NullToBoolConverter}, Mode=OneWay}"
                                                    ToolTipService.ToolTip="Browse for .usmap file">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="AES Encryption Key" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                                        <TextBox PlaceholderText="0x123456... (if encrypted)"
                                                 Text="{x:Bind ViewModel.SelectedGame.AesKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                                                 IsEnabled="{Binding SelectedGame, Converter={StaticResource NullToBoolConverter}, Mode=OneWay}"
                                                 FontFamily="Consolas"
                                                 FontSize="11"/>
                                    </StackPanel>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>

                    <Grid RowSpacing="18"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          Visibility="{Binding IsShortcutsSelected, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Shortcuts"
                                       FontSize="24"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Customize your core keyboard actions."
                                       FontSize="13"
                                       Opacity="0.68"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="18"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <ListView ItemsSource="{x:Bind ViewModel.Shortcuts, Mode=OneWay}"
                                      SelectionMode="None"
                                      IsItemClickEnabled="False"
                                      Padding="0"
                                      Margin="0">
                                <ListView.Header>
                                    <Grid Padding="18,14" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Command" FontWeight="SemiBold" Opacity="0.8"/>
                                        <TextBlock Text="Key binding" FontWeight="SemiBold" Opacity="0.8" Grid.Column="1"/>
                                    </Grid>
                                </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="settings:ShortcutConfig">
                                        <Grid Padding="18,14" MinHeight="52" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Click="EditShortcut_Click"
                                                    Tag="{x:Bind}"
                                                    Background="Transparent"
                                                    BorderThickness="1"
                                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                    CornerRadius="8"
                                                    Padding="12,6"
                                                    MinHeight="32"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DisplayString, Mode=OneWay}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,20,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button Content="Cancel"
                        Width="96"
                        Click="CloseButton_Click"/>
                <Button Content="Save changes"
                        Width="150"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
