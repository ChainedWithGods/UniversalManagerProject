<ContentDialog
    x:Class="PakViewer.Views.UpdatePrompt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Update Available"
    PrimaryButtonText="Update Now"
    SecondaryButtonText="Remind Me Later"
    CloseButtonText="Skip This Version"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    CloseButtonClick="ContentDialog_CloseButtonClick">

    <Grid Width="460" RowSpacing="12" Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Version Transition Card -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="38" Height="38"
                        CornerRadius="8"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE896;"
                              FontSize="18"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="A new version of PakViewer is ready!"
                               FontWeight="SemiBold"
                               FontSize="13.5"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="4"
                                Padding="8,2">
                            <TextBlock x:Name="CurrentVersionTextBlock"
                                       FontSize="11.5"
                                       FontWeight="Medium"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Border>
                        <FontIcon Glyph="&#xE72A;"
                                  FontSize="11"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  VerticalAlignment="Center"/>
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4"
                                Padding="8,2">
                            <TextBlock x:Name="LatestVersionTextBlock"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Release Notes Section -->
        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="Release Notes"
                       FontWeight="SemiBold"
                       FontSize="12.5"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <ScrollViewer MaxHeight="160"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="ChangelogTextBlock"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               FontSize="12.5"
                               LineHeight="18"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Download Progress Panel (Shown during download) -->
        <Border x:Name="ProgressBorder"
                Grid.Row="2"
                Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock x:Name="ProgressStatusTextBlock"
                               Text="Connecting to server..."
                               FontSize="12"
                               FontWeight="Medium"
                               HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ProgressPercentTextBlock"
                               Text=""
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                               HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar x:Name="DownloadProgressBar"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             IsIndeterminate="True"
                             Height="6"
                             CornerRadius="3"/>
                <TextBlock x:Name="ProgressDetailTextBlock"
                           Text=""
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Error Panel (Collapsed by default) -->
        <Border x:Name="ErrorBorder"
                Grid.Row="3"
                Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel Spacing="6">
                <TextBlock x:Name="ErrorMessageTextBlock"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap"
                           FontSize="12"/>
                <HyperlinkButton x:Name="BrowserFallbackButton"
                                 Content="Open Download Link in Browser"
                                 Visibility="Collapsed"
                                 Click="BrowserFallbackButton_Click"
                                 Padding="0"/>
            </StackPanel>
        </Border>
    </Grid>
</ContentDialog>
