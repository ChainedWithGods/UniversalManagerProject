<UserControl
    x:Class="PakViewer.Views.ConflictDashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PakViewer.Models"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.RowSpacing>16</Grid.RowSpacing>

        <!-- Compact Mod Header Banner (Row 0) -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Mod Information Block -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock x:Name="DashboardModNameText"
                                   Text="Mod Conflict Dashboard"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                        <!-- Inline Collisions Badge -->
                        <Border x:Name="DashboardImpactBadge"
                                Background="#28EF4444"
                                BorderBrush="#40EF4444"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,2"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="#EF4444"/>
                                <TextBlock x:Name="DashboardImpactBadgeText"
                                           Text="59 File Collisions"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#EF4444"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- File Path Truncation -->
                    <TextBlock x:Name="DashboardModSubtext"
                               Text="C:/program files (x86)/steam/steamapps/common/TEKKEN 8/Polaris/Content/Paks/Mods/..."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Action Bar Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="DashboardView3DButton"
                            Click="DashboardView3D_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            CornerRadius="6"
                            Height="32"
                            Padding="12,0"
                            FontWeight="SemiBold"
                            ToolTipService.ToolTip="Launch interactive 3D model viewport">
                        <TextBlock Text="Inspect 3D Model" FontSize="12"/>
                    </Button>

                    <DropDownButton x:Name="Select3DModelButton"
                                    CornerRadius="6"
                                    Height="32"
                                    Padding="10,0"
                                    ToolTipService.ToolTip="Select specific 3D mesh model to inspect">
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="Inspect3DFlyout" Placement="Bottom"/>
                        </DropDownButton.Flyout>
                        <TextBlock Text="Select Model" FontSize="12"/>
                    </DropDownButton>

                    <Button Click="DashboardExportReport_Click"
                            CornerRadius="6"
                            Height="32"
                            Padding="12,0"
                            ToolTipService.ToolTip="Export diagnostic conflict report">
                        <TextBlock Text="Export Report" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Professional 3 Metric Hero Cards (Row 1) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.ColumnSpacing>14</Grid.ColumnSpacing>

            <!-- Stat 1: 3D Meshes & Physics Card -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="#20EF4444"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,14">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Header Label & Icon -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="#18EF4444" CornerRadius="8" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="ms-appx:///Icons/Physics.ico" Width="24" Height="24"/>
                            </Border>
                            <TextBlock Text="3D Meshes &amp; Physics" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Severity Pill Tag -->
                        <Border Grid.Column="1" Background="#1AEF4444" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="HIGH IMPACT" FontSize="10" FontWeight="Bold" Foreground="#EF4444"/>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                        <TextBlock x:Name="StatCriticalCountText" Text="2" FontSize="28" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Bottom" LineHeight="28"/>
                        <TextBlock Text="Mesh, geometry &amp; physics overrides" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Stat 2: Material & Texture Overlaps Card -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="#20F59E0B"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,14">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Header Label & Icon -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="#18F59E0B" CornerRadius="8" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="ms-appx:///Icons/Materials.ico" Width="24" Height="24"/>
                            </Border>
                            <TextBlock Text="Materials &amp; Textures" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Visual Tag -->
                        <Border Grid.Column="1" Background="#1AF59E0B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="VISUAL OVERLAY" FontSize="10" FontWeight="Bold" Foreground="#F59E0B"/>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                        <TextBlock x:Name="StatVisualCountText" Text="51" FontSize="28" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Bottom" LineHeight="28"/>
                        <TextBlock Text="Shaders, instances &amp; texture recolors" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Stat 3: Primary Rival Mod Card -->
            <Border Grid.Column="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,14">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Header Label & Icon -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="ms-appx:///Icons/Character.ico" Width="24" Height="24"/>
                            </Border>
                            <TextBlock Text="Primary Rival Mod" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Overlap % Tag -->
                        <Border Grid.Column="1" x:Name="StatPrimaryRivalBadge" Background="#1AEF4444" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock x:Name="StatPrimaryRivalBadgeText" Text="100% COLLISION" FontSize="10" FontWeight="Bold" Foreground="#EF4444"/>
                        </Border>
                    </Grid>

                    <StackPanel Spacing="2">
                        <TextBlock x:Name="StatPrimaryRivalText" Text="Black_Suit_P" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="StatPrimaryRivalSubtext" Text="59 overlapping files detected" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content Area: 65% Asset Explorer / 35% Rival Breakdown (Row 2) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*"/>
                <ColumnDefinition Width="35*"/>
            </Grid.ColumnDefinitions>
            <Grid.ColumnSpacing>18</Grid.ColumnSpacing>

            <!-- Left: Conflicting Assets Explorer Card -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Explorer Filter Header Bar -->
                    <Border Grid.Row="0"
                            Padding="20,16,20,14"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Spacing="14">

                            <!-- Row 1: Title Badge & Search Box -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Title & Count Badge -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="#EF4444"/>
                                    <TextBlock Text="Conflicting Assets" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                    <Border x:Name="ExplorerAssetCountBadge"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="10"
                                            Padding="8,3"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="ExplorerAssetCountText" Text="59" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Search Box -->
                                <TextBox x:Name="DashboardConflictSearch"
                                         Grid.Column="1"
                                         TextChanged="DashboardConflictSearch_TextChanged"
                                         PlaceholderText="Search assets or paths..."
                                         Width="260"
                                         CornerRadius="8"/>
                            </Grid>

                            <!-- Row 2: Dynamic Filter Chips -->
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Enabled"
                                          VerticalScrollMode="Disabled">
                                <ItemsControl x:Name="DynamicFilterChipsItemsControl" Margin="0,2,0,2">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CategoryFilterChip">
                                            <Button Click="DynamicFilterChip_Click"
                                                    Tag="{Binding CategoryTag}"
                                                    Style="{Binding ButtonStyle}"
                                                    CornerRadius="16"
                                                    Height="34"
                                                    Padding="16,0"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                        </StackPanel>
                    </Border>

                    <!-- Conflicting Assets ListView -->
                    <ScrollViewer Grid.Row="1" MaxHeight="620" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ListView x:Name="DashboardConflictsListView" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ConflictFileItem">
                                        <Border Padding="16,14"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Asset Type Icon -->
                                                <Border Grid.Column="0"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="10"
                                                        Width="46" Height="46"
                                                        Margin="0,0,14,0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <Image Source="{Binding CategoryIconSource}" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Asset Details -->
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CategoryName}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    
                                                    <TextBlock Text="{Binding DirectoryPath}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE7C3;" FontSize="11" Foreground="#EF4444" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Collides with:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding ConflictingModsText}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Severity Badge Pill -->
                                                <Border Grid.Column="2"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="8"
                                                        Padding="12,6"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SeverityTitle}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Empty State -->
                            <StackPanel x:Name="DashboardConflictsEmptyState"
                                        Visibility="Collapsed"
                                        Padding="40"
                                        HorizontalAlignment="Center"
                                        Spacing="12">
                                <FontIcon Glyph="&#xE936;" FontSize="48" Foreground="#0E9F6E"/>
                                <TextBlock Text="No file conflicts found!" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right: Rival Mod Collision Breakdown -->
            <StackPanel Grid.Column="1" Spacing="16">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Padding="18,14"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Colliding Rival Mods" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="RivalModsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:RivalModSummary">
                                        <Border Padding="16,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding ModName}" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="13" FontWeight="SemiBold" Foreground="#EF4444"/>
                                                </Grid>

                                                <ProgressBar Value="{Binding PercentValue}" Maximum="100" Height="4" Foreground="#EF4444"/>
                                                
                                                <TextBlock Text="{Binding CollidingFilesText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Asset Type Summary Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Image Source="ms-appx:///Icons/Types.ico" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Asset Type Summary" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        </StackPanel>

                        <ItemsControl x:Name="DashboardCategorySummaryItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding IconSource}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Count}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

    </Grid>
</UserControl>