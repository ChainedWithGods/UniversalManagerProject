<Window
    x:Class="PakViewer.Views.ViewerSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PakViewer.Models"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,12" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="3D Model Viewer" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="Controls &amp; Settings" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
            </StackPanel>
            
            <Button Grid.Column="1" Click="CloseButton_Click" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE711;"/>
            </Button>
        </Grid>

        <!-- Content -->
        <Pivot Grid.Row="1" SelectionChanged="Pivot_SelectionChanged" x:Name="MainPivot">
            <!-- Camera Tab -->
            <PivotItem Header="Camera">
                <ScrollViewer Padding="24">
                    <StackPanel Spacing="24">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Camera Presets" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <StackPanel Spacing="8">
                                <TextBlock Text="• F1 = Front View"/>
                                <TextBlock Text="• F2 = Back View"/>
                                <TextBlock Text="• F3 = Left View"/>
                                <TextBlock Text="• F4 = Right View"/>
                                <TextBlock Text="• F5 = Top View"/>
                                <TextBlock Text="• F6 = Bottom View"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="12">
                            <TextBlock Text="Camera Control" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <StackPanel Spacing="8">
                                <TextBlock Text="• R = Reset Camera"/>
                                <TextBlock Text="• Left Mouse Drag = Rotate"/>
                                <TextBlock Text="• Middle Mouse Drag = Pan"/>
                                <TextBlock Text="• Mouse Scroll = Zoom In/Out"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Display Tab -->
            <PivotItem Header="Display">
                <ScrollViewer Padding="24">
                    <StackPanel Spacing="24">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Display Options" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <StackPanel Spacing="8">
                                <TextBlock Text="• G = Toggle Grid Floor"/>
                                <TextBlock Text="• J = Toggle Wireframe Mode"/>
                                <TextBlock Text="• B = Toggle Backface Culling"/>
                                <TextBlock Text="• H = Show/Hide This Window"/>
                                <TextBlock Text="• ESC = Close Viewer"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="12">
                            <TextBlock Text="Render Settings" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Two-Sided Rendering" FontWeight="SemiBold"/>
                                        <TextBlock Text="Show both front and back faces of the mesh" FontSize="12" Opacity="0.6"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="BackfaceCullingToggle" Grid.Column="1" Toggled="BackfaceCullingToggle_Changed" OnContent="" OffContent=""/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="12">
                            <TextBlock Text="Performance Stats" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Window title bar displays:" FontWeight="SemiBold"/>
                                    <TextBlock Text="• FPS (frames per second)"/>
                                    <TextBlock Text="• Vertex count"/>
                                    <TextBlock Text="• Triangle count"/>
                                    <TextBlock Text="• Model bounding box dimensions"/>
                                    <TextBlock Text="• Wireframe mode status"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Body Parts Tab -->
            <PivotItem Header="Body Parts">
                <Grid Padding="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="8">
                        <TextBlock Text="Toggle Mesh Sections" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE92E;"/>
                            <TextBlock Text="Press SPACE to toggle all sections" Opacity="0.8" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE92E;"/>
                            <TextBlock Text="Press 0-9 for sections 0-9, Shift+0-9 for sections 10-19" Opacity="0.8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl x:Name="MeshSectionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Grid.Column="0" Background="{ThemeResource SystemControlBackgroundAccentBrush}" CornerRadius="4" Width="24" Height="24" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Shortcut}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                        
                                        <StackPanel Grid.Column="1" Margin="12,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.6"/>
                                        </StackPanel>
                                        
                                        <Button Grid.Column="2" Grid.ColumnSpan="2" Content="Toggle" Click="ToggleSection_Click" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <!-- Settings Tab -->
            <PivotItem Header="Settings">
                <StackPanel Padding="24" Spacing="24">
                    <TextBlock Text="General Settings" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="Screenshot Save Location"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ScreenshotPathTextBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse..." Click="BrowseButton_Click"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="Window Settings" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Always on Top" FontWeight="SemiBold"/>
                                <TextBlock Text="Keep this window above the 3D viewer" FontSize="12" Opacity="0.6"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AlwaysOnTopToggle" Grid.Column="1" Toggled="AlwaysOnTopToggle_Changed" OnContent="" OffContent=""/>
                        </Grid>
                    </Border>
                </StackPanel>
            </PivotItem>

            <!-- Material Inspector Tab -->
            <PivotItem Header="Material Inspector">
                <ScrollViewer Padding="24">
                    <StackPanel x:Name="MaterialInspectorContent" Spacing="8"/>
                </ScrollViewer>
            </PivotItem>

            <!-- Blocked Materials Tab -->
            <PivotItem Header="Blocked Materials">
                <ScrollViewer Padding="24">
                    <StackPanel x:Name="BlockedMaterialsContent" Spacing="16">
                        <TextBlock Text="Blocked Material Names" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="Sections using these materials are hidden by default. Toggle ON to show them." FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Dependency Graph Tab -->
            <PivotItem Header="Dependencies">
                <Grid Padding="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Summary -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="8">
                        <TextBlock Text="Asset Dependency Graph" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="Mesh → Material Slots → Textures chain with resolution status" FontSize="12" Opacity="0.6"/>
                    </StackPanel>

                    <!-- Legend -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="10" Height="10" Fill="Green" VerticalAlignment="Center"/>
                            <TextBlock Text="Resolved" FontSize="12" Opacity="0.8" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="10" Height="10" Fill="Orange" VerticalAlignment="Center"/>
                            <TextBlock Text="Fallback" FontSize="12" Opacity="0.8" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="10" Height="10" Fill="Red" VerticalAlignment="Center"/>
                            <TextBlock Text="Missing" FontSize="12" Opacity="0.8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Tree -->
                    <TreeView Grid.Row="2"
                              x:Name="DependencyTreeView"
                              SelectionMode="Single"
                              ItemInvoked="DependencyTreeView_ItemInvoked"
                              CornerRadius="8"
                              Background="{ThemeResource LayerFillColorDefaultBrush}"
                              CanDragItems="False"
                              AllowDrop="False"
                              CanReorderItems="False">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="models:DependencyNode">
                                <TreeViewItem ItemsSource="{x:Bind Children, Mode=OneWay}"
                                              IsExpanded="True">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- Status Dot -->
                                        <Ellipse Width="10" Height="10"
                                                 Fill="{x:Bind StatusColor, Mode=OneWay}"
                                                 VerticalAlignment="Center"/>

                                        <!-- Type Badge -->
                                        <Border Background="{x:Bind TypeBadgeColor, Mode=OneWay}"
                                                CornerRadius="3"
                                                Padding="6,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind TypeLabel, Mode=OneWay}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>

                                        <!-- Name -->
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" 
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="300"/>

                                        <!-- VFS Origin -->
                                        <TextBlock Text="{x:Bind VfsName, Mode=OneWay}" 
                                                   FontSize="10" 
                                                   Opacity="0.5"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind HasVfsName, Mode=OneWay}"/>
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Window>
