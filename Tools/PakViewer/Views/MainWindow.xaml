<Window
    x:Class="PakViewer.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:PakViewer.ViewModels"
    xmlns:models="using:PakViewer.Models"
    xmlns:converters="using:PakViewer.Converters"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:localcontrols="using:PakViewer.Controls"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="LoadGameAccelerator_Invoked"/>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked"/>
            <!-- Use I for Settings (Info) to avoid OemComma issues for now, or use Click handler on button -->
            <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="SettingsAccelerator_Invoked"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,6,160,6" Background="{ThemeResource LayerFillColorDefaultBrush}" Height="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left: App Branding -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Image Source="ms-appx:///Icons/PakViewer.png"
                       Width="38"
                       Height="38"
                       Stretch="Uniform"
                       VerticalAlignment="Center"/>
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="PakViewer" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Have Hope"
                               FontSize="10"
                               Opacity="0.7"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
            
            <!-- Center: Game Selection -->
            <StackPanel x:Name="GameSelectorPanel"
                        Grid.Column="1" 
                        Orientation="Horizontal" 
                        Spacing="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <ComboBox x:Name="GameSelectorCombo"
                          ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          PlaceholderText="Select game..."
                          MinWidth="220"
                          MaxWidth="320"
                          CornerRadius="6"/>
                <TextBlock x:Name="GameNameText"
                           Text="{x:Bind ViewModel.SelectedGame.Name, Mode=OneWay, FallbackValue=''}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </StackPanel>
            <!-- Right: Actions -->
            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal" 
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button x:Name="LoadGameButton"
                        Content="Load Game" 
                        Command="{x:Bind ViewModel.LoadGameCommand, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="36"
                        Padding="16,0"
                        CornerRadius="6"
                        ToolTipService.ToolTip="Load game archives (Ctrl+L)"/>
                <Button Command="{x:Bind ViewModel.OpenSettingsCommand, Mode=OneWay}"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="38"
                        Height="38"
                        CornerRadius="6"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- Full View (existing UI) -->
            <Grid x:Name="FullViewGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" MinWidth="250" MaxWidth="600"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Custom Tab Headers -->
                <Border Grid.Row="0" 
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Archives Tab Header -->
                        <Button Grid.Column="0" 
                                Click="TabButton_Click"
                                Tag="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                            </Button.Resources>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE7B8;" FontSize="16"/>
                                    <TextBlock Text="Archives" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="ArchivesCount"
                                           Text="{x:Bind ViewModel.FilteredArchives.Count, Mode=OneWay, FallbackValue='0'}" 
                                           FontSize="11"
                                           Opacity="0.7"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Folders Tab Header -->
                        <Button Grid.Column="1" 
                                Click="TabButton_Click"
                                Tag="1"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                            </Button.Resources>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8DA;" FontSize="16"/>
                                    <TextBlock Text="Folders" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.FileTree.Count, Mode=OneWay, FallbackValue='0'}" 
                                           FontSize="11"
                                           Opacity="0.7"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Packages Tab Header -->
                        <Button Grid.Column="2" 
                                Click="TabButton_Click"
                                Tag="2"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                            </Button.Resources>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="16"/>
                                    <TextBlock Text="Packages" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Packages.Count, Mode=OneWay, FallbackValue='0'}" 
                                           FontSize="11"
                                           Opacity="0.7"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Active Tab Indicator -->
                        <Border x:Name="TabIndicator"
                                Height="3"
                                Background="#1E88E5"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch"
                                CornerRadius="2,2,0,0"
                                Width="126"
                                Margin="0,0,254,0"/>
                    </Grid>
                </Border>
                
                <!-- Tab Content -->
                <Grid Grid.Row="1">
                    <!-- Archives Tab Content -->
                    <Grid x:Name="ArchivesTab" Visibility="Visible" Padding="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Filters Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{x:Bind ViewModel.LoadingModes, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedLoadingMode, Mode=TwoWay}"
                                      Header="Loading Mode"
                                      HorizontalAlignment="Stretch"/>
                            
                            <ComboBox Grid.Column="2"
                                      Header="Show"
                                      SelectedIndex="{x:Bind ViewModel.ArchivesFilterIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="Mods Only"/>
                                <ComboBoxItem Content="Game Only"/>
                            </ComboBox>
                        </Grid>
                        
                        <!-- Search and Sort Row -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0"
                                     x:Name="ArchivesSearchBox"
                                     Text="{x:Bind ViewModel.ArchivesSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Search archives...">
                                <TextBox.Resources>
                                    <FontIcon x:Key="SearchIcon" Glyph="&#xE721;" FontSize="14"/>
                                </TextBox.Resources>
                            </TextBox>
                            
                            <ComboBox Grid.Column="2"
                                      SelectedIndex="{x:Bind ViewModel.ArchivesSortIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Name ↑"/>
                                <ComboBoxItem Content="Name ↓"/>
                                <ComboBoxItem Content="Files ↑"/>
                                <ComboBoxItem Content="Files ↓"/>
                                <ComboBoxItem Content="Size ↑"/>
                                <ComboBoxItem Content="Size ↓"/>
                            </ComboBox>
                        </Grid>

                        <!-- Load Button -->
                        <Button Grid.Row="2"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="LoadArchives_Click"
                                Height="40"
                                Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                                <TextBlock Text="Load Archives" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Archives List -->
                        <ListView Grid.Row="3"
                                  x:Name="ArchivesListView"
                                  ItemsSource="{x:Bind ViewModel.FilteredArchives, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedArchive, Mode=TwoWay}"
                                  SelectionMode="Multiple"
                                  DoubleTapped="ArchivesList_DoubleTapped"
                                  CornerRadius="8"
                                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                                  CanDragItems="False"
                                  AllowDrop="False"
                                  CanReorderItems="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:ArchiveViewModel">
                                    <Grid Padding="8,8" MinHeight="60">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Game File Icon -->
                                        <FontIcon Grid.Column="0"
                                                  Glyph="&#xE7B8;"
                                                  FontSize="32"
                                                  Foreground="#2196F3"
                                                  Margin="0,0,12,0"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding IsGameFile, Converter={StaticResource BoolToVis}}"/>

                                        <!-- Mod Icon -->
                                        <FontIcon Grid.Column="0"
                                                  Glyph="&#xF133;"
                                                  FontSize="32"
                                                  Foreground="#4CAF50"
                                                  Margin="0,0,12,0"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding IsMod, Converter={StaticResource BoolToVis}}"/>
                                        
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <TextBlock Grid.Row="0"
                                                       Text="{x:Bind Name, Mode=OneWay}" 
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,0,2"/>
                                            
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" FlowDirection="LeftToRight">
                                                <TextBlock Text="{x:Bind FormattedSize, Mode=OneWay}" 
                                                           FontSize="11"
                                                           Opacity="0.7"/>
                                                <TextBlock Text="•" FontSize="11" Opacity="0.5"/>
                                                <TextBlock Text="{x:Bind FileCountDisplay, Mode=OneWay}" 
                                                           FontSize="11"
                                                           Opacity="0.7"/>
                                                
                                                <!-- GAME Badge -->
                                                <Border Background="#2196F3"
                                                        CornerRadius="3"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsGameFile, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="GAME"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"/>
                                                </Border>

                                                <!-- MOD Badge -->
                                                <Border Background="#4CAF50"
                                                        CornerRadius="3"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsMod, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="MOD"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    
                <!-- Folders Tab Content -->
                <Grid x:Name="FoldersTab" Visibility="Collapsed" Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Search Box -->
                    <TextBox Grid.Row="0"
                             x:Name="FoldersSearchBox"
                             Text="{x:Bind ViewModel.FolderSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Search folders and files..."
                             Margin="0,0,0,12"/>
                    
                    <!-- Folders Tree (shown when not searching) -->
                    <TreeView Grid.Row="1"
                              x:Name="FoldersTreeView"
                              ItemsSource="{x:Bind ViewModel.FileTree, Mode=OneWay}"
                              SelectionMode="Single"
                              ItemInvoked="FoldersTreeView_ItemInvoked"
                              DoubleTapped="FoldersTreeView_DoubleTapped"
                              RightTapped="FileItem_RightTapped"
                              CornerRadius="8"
                              Background="{ThemeResource LayerFillColorDefaultBrush}"
                              CanDragItems="False"
                              AllowDrop="False"
                              CanReorderItems="False"
                              Visibility="{x:Bind ViewModel.ShowTreeView, Mode=OneWay}">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="models:FileNodeViewModel">
                                <TreeViewItem ItemsSource="{x:Bind Children, Mode=OneWay}"
                                              IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                    <TreeViewItem.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Copy Path" Icon="Copy" Click="CopyPath_Click" Tag="{x:Bind}"/>
                                            <MenuFlyoutItem Text="Open Path" Click="OpenPath_Click" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8DA;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Copy Item Name" Icon="Rename" Click="CopyItemName_Click" Tag="{x:Bind}"/>
                                        </MenuFlyout>
                                    </TreeViewItem.ContextFlyout>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- Dynamic icon based on file type -->
                                        <FontIcon Glyph="{x:Bind FileIcon, Mode=OneWay}"
                                                  FontSize="{x:Bind TreeIconSize, Mode=OneWay}"
                                                  Foreground="{x:Bind FolderColor, Mode=OneWay}"
                                                  Visibility="{Binding HasCustomIcon, Converter={StaticResource InverseBoolToVis}}"/>

                                        <!-- Custom Icon (Image) -->
                                        <Image Width="{x:Bind TreeIconSize, Mode=OneWay}"
                                               Height="{x:Bind TreeIconSize, Mode=OneWay}"
                                               Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVis}}">
                                            <Image.Source>
                                                <BitmapImage UriSource="{x:Bind CustomIconUri, Mode=OneWay}" DecodePixelWidth="64"/>
                                            </Image.Source>
                                        </Image>

                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind DisplayCount, Mode=OneWay}" 
                                                   FontSize="11" 
                                                   Opacity="0.6"/>
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    
                    <!-- Search Results List (shown when searching) -->
                    <ListView Grid.Row="1"
                              x:Name="SearchResultsListView"
                              ItemsSource="{x:Bind ViewModel.FilteredFileTree, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedSearchResult, Mode=TwoWay}"
                              SelectionMode="Single"
                              DoubleTapped="FoldersTreeView_DoubleTapped"
                              RightTapped="FileItem_RightTapped"
                              CornerRadius="8"
                              Background="{ThemeResource LayerFillColorDefaultBrush}"
                              CanDragItems="False"
                              AllowDrop="False"
                              CanReorderItems="False"
                              Visibility="{x:Bind ViewModel.ShowSearchResults, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FileNodeViewModel">
                                <Grid Padding="12" MinHeight="60">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Copy Path" Icon="Copy" Click="CopyPath_Click" Tag="{x:Bind}"/>
                                            <MenuFlyoutItem Text="Open Path" Click="OpenPath_Click" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8DA;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Copy Item Name" Icon="Rename" Click="CopyItemName_Click" Tag="{x:Bind}"/>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Grid Grid.Column="0"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind FileIcon, Mode=OneWay}"
                                                  FontSize="32"
                                                  Foreground="{x:Bind FolderColor, Mode=OneWay}"
                                                  Visibility="{Binding HasCustomIcon, Converter={StaticResource InverseBoolToVis}}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        <Image Width="{x:Bind CustomIconSize, Mode=OneWay}"
                                               Height="{x:Bind CustomIconSize, Mode=OneWay}"
                                               Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVis}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                            <Image.Source>
                                                <BitmapImage UriSource="{x:Bind CustomIconUri, Mode=OneWay}" DecodePixelWidth="32"/>
                                            </Image.Source>
                                        </Image>
                                    </Grid>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" 
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="{x:Bind FullPath, Mode=OneWay}" 
                                                   FontSize="11"
                                                   Opacity="0.6"
                                                   TextWrapping="Wrap"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    
                                    <TextBlock Grid.Column="2" 
                                               Text="{x:Bind FormattedSize, Mode=OneWay}"
                                               FontSize="12"
                                               Opacity="0.7"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Visibility="{Binding IsDirectory, Converter={StaticResource InverseBoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                
                <!-- Packages Tab Content -->
                <Grid x:Name="PackagesTab" Visibility="Collapsed" Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Search Box -->
                    <TextBox Grid.Row="0"
                             Text="{x:Bind ViewModel.PackagesSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Search packages..."
                             Margin="0,0,0,12"/>
                    
                    <!-- Packages List -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.FilteredPackages, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedPackage, Mode=TwoWay}"
                              SelectionMode="Single"
                              DoubleTapped="PackagesList_DoubleTapped"
                              CornerRadius="8"
                              Background="{ThemeResource LayerFillColorDefaultBrush}"
                              CanDragItems="False"
                              AllowDrop="False"
                              CanReorderItems="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FileNodeViewModel">
                                <Grid Padding="12" MinHeight="60">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Grid Grid.Column="0"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind FileIcon, Mode=OneWay}"
                                                  FontSize="32"
                                                  Foreground="#1E88E5"
                                                  Visibility="{Binding HasCustomIcon, Converter={StaticResource InverseBoolToVis}}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        <Image Width="{x:Bind CustomIconSize, Mode=OneWay}"
                                               Height="{x:Bind CustomIconSize, Mode=OneWay}"
                                               Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVis}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                            <Image.Source>
                                                <BitmapImage UriSource="{x:Bind CustomIconUri, Mode=OneWay}" DecodePixelWidth="32"/>
                                            </Image.Source>
                                        </Image>
                                    </Grid>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" 
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="{x:Bind Extension, Mode=OneWay}" 
                                                   FontSize="11"
                                                   Opacity="0.7"/>
                                    </StackPanel>
                                    
                                    <TextBlock Grid.Column="2" 
                                               Text="{x:Bind FormattedSize, Mode=OneWay}"
                                               FontSize="12"
                                               Opacity="0.7"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
            </Grid>

            <!-- Splitter (Resizable) -->
            <controls:GridSplitter Grid.Column="1" 
                                   Width="2"
                                   HorizontalAlignment="Stretch"
                                   Background="{ThemeResource LayerFillColorDefaultBrush}"
                                   CursorBehavior="ChangeOnSplitterHover"
                                   ResizeBehavior="BasedOnAlignment"
                                   ResizeDirection="Columns"
                                   Margin="0,0,0,16">
                <controls:GridSplitter.Style>
                    <Style TargetType="controls:GridSplitter">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="controls:GridSplitter">
                                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                                        <ContentPresenter Content="{TemplateBinding Element}" 
                                                        HorizontalAlignment="Stretch" 
                                                        VerticalAlignment="Stretch"/>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </controls:GridSplitter.Style>
                <controls:GridSplitter.Element>
                    <Grid Background="Transparent">
                        <Rectangle Width="0" 
                                   HorizontalAlignment="Center"
                                   Fill="Transparent"/>
                    </Grid>
                </controls:GridSplitter.Element>
            </controls:GridSplitter>

            <!-- Right Panel -->
            <Grid Grid.Column="2" Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Preview Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0"
                                HorizontalAlignment="Left">
                        <TextBlock Text="File Preview" 
                                   FontSize="20" 
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <!-- Breadcrumb-like path display -->
                        <TextBlock Text="{x:Bind ViewModel.SelectedPreviewNode.FullPath, Mode=OneWay, FallbackValue='Select a file to view details'}" 
                                   FontSize="13"
                                   Opacity="0.7"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="500"
                                   HorizontalAlignment="Left"
                                   TextAlignment="Left">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="{x:Bind ViewModel.SelectedPreviewNode.FullPath, Mode=OneWay}"/>
                            </ToolTipService.ToolTip>
                        </TextBlock>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal" 
                                Spacing="8"
                                Visibility="{x:Bind FileInfoVisibility, Mode=OneWay}">
                        
                        <AppBarButton Click="NavigateBack_Click"
                                      IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                                      IsCompact="True"
                                      ElementSoundMode="Off">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="Back"/>
                            </AppBarButton.Icon>
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Back"/>
                            </ToolTipService.ToolTip>
                        </AppBarButton>
                        <AppBarButton Click="NavigateForward_Click"
                                      IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}"
                                      IsCompact="True"
                                      ElementSoundMode="Off">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="Forward"/>
                            </AppBarButton.Icon>
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Forward"/>
                            </ToolTipService.ToolTip>
                        </AppBarButton>
                        <ToggleSwitch OnContent="Grid" 
                                      OffContent="Text"
                                      IsOn="{x:Bind ViewModel.IsExploreMode, Mode=TwoWay}"
                                      Margin="0,0,12,0"
                                      MinWidth="100"/>

                        <Button Height="32" Padding="12,0"
                                Click="View3D_Click"
                                Visibility="{x:Bind ModelViewerVisibility, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xF133;" FontSize="14"/>
                                <TextBlock Text="View 3D"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Preview Card -->
                <Border Grid.Row="1" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <!-- JSON/Text Preview with Syntax Highlighting -->
                        <Grid Visibility="{x:Bind ViewModel.PreviewTextVisibility, Mode=OneWay}">
                            <localcontrols:TextPreviewControl x:Name="TextPreview"
                                                         Margin="16"
                                                         Visibility="{x:Bind FileInfoVisibility, Mode=OneWay}"/>
                        </Grid>

                        <!-- Explore Grid View -->
                        <Grid Visibility="{x:Bind ViewModel.ExploreGridVisibility, Mode=OneWay}">
                            <GridView x:Name="ExploreGridView"
                                      ItemsSource="{x:Bind ViewModel.ExploreItems, Mode=OneWay}"
                                      SelectionMode="Single"
                                      Padding="12"
                                      IsItemClickEnabled="True"
                                      ItemClick="ExploreGrid_ItemClick"
                                      DoubleTapped="ExploreGrid_DoubleTapped"
                                      Visibility="{x:Bind FileInfoVisibility, Mode=OneWay}">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:FileNodeViewModel">
                                        <Grid Width="140" MinHeight="140" Padding="8" Background="Transparent" CornerRadius="4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="100"/>
                                                <RowDefinition Height="32"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Icon -->
                                            <Grid Grid.Row="0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind FileIcon, Mode=OneWay}" 
                                                          FontSize="48" 
                                                          Foreground="{x:Bind FolderColor, Mode=OneWay}"
                                                          Visibility="{Binding IsIconVisibleForPreview, Converter={StaticResource BoolToVis}}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Width="64"
                                                          Height="64"/>
                                                <Image Width="64"
                                                       Height="64"
                                                       Visibility="{Binding HasCustomIconForPreview, Converter={StaticResource BoolToVis}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                    <Image.Source>
                                                        <BitmapImage UriSource="{x:Bind CustomIconUriForPreview, Mode=OneWay}" DecodePixelWidth="64"/>
                                                    </Image.Source>
                                                </Image>
                                                <Image Source="{Binding Thumbnail}"
                                                       Visibility="{Binding Thumbnail, Converter={StaticResource NullToVis}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Stretch="Uniform"
                                                       MaxHeight="100"
                                                       MaxWidth="124"/>
                                            </Grid>
                                            
                                            <!-- Name -->
                                            <TextBlock Grid.Row="1" 
                                                       Text="{x:Bind DisplayName, Mode=OneWay}" 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap"
                                                       TextTrimming="None"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       LineHeight="12"
                                                       MaxLines="2"
                                                       Margin="0,8,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Grid>
                        
                        <!-- Empty State -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="16"
                                    Visibility="{x:Bind EmptyStateVisibility, Mode=OneWay}">
                            <FontIcon Glyph="&#xE8A5;" 
                                      FontSize="64" 
                                      Opacity="0.3"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="No file selected" 
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Select a file from the list to view its content" 
                                       FontSize="13"
                                       Opacity="0.7"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="300"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            </Grid>

            <!-- Minimal View (Asset Gallery) -->
            <Grid x:Name="MinimalViewGrid" Visibility="Collapsed" DataContext="{x:Bind}">
                <ScrollViewer Padding="20">
                    <StackPanel Spacing="32">
                        
                        <!-- Header -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Padding="24,20"
                                CornerRadius="12">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock Text="Asset Gallery" 
                                               FontSize="28" 
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ToggleButton x:Name="ShowThumbnailsToggle"
                                                      Click="ShowThumbnailsToggle_Click"
                                                      ToolTipService.ToolTip="Toggle texture thumbnails in gallery cards">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8B9;" FontSize="14"/>
                                                <TextBlock Text="Thumbnails" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="CodeViewToggle"
                                                      ToolTipService.ToolTip="Toggle code view mode — double-click assets to view serialized data">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE943;" FontSize="14"/>
                                                <TextBlock Text="Code View" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind AssetCategories, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="16"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:AssetCategory">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <BitmapIcon UriSource="{x:Bind IconUri, Mode=OneWay}"
                                                            ShowAsMonochrome="False"
                                                            Width="28"
                                                            Height="28"/>
                                                <TextBlock FontSize="13" Opacity="0.8" VerticalAlignment="Center">
                                                    <Run Text="{x:Bind Count, Mode=OneWay}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{x:Bind Name, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        
                        <!-- Dynamic Categories -->
                        <ItemsControl ItemsSource="{x:Bind AssetCategories, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AssetCategory">
                                    <StackPanel Spacing="12" Margin="0,0,0,20">
                                        <!-- Category Header -->
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <BitmapIcon UriSource="{x:Bind IconUri, Mode=OneWay}"
                                                        ShowAsMonochrome="False"
                                                        Width="40"
                                                        Height="40"/>
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" 
                                                       FontSize="20" 
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind DisplayCount, Mode=OneWay}"
                                                       FontSize="14"
                                                       Opacity="0.6"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,0,0"/>
                                        </StackPanel>
                                        
                                        <!-- Assets Grid -->
                                        <GridView ItemsSource="{x:Bind Assets, Mode=OneWay}"
                                                  SelectionMode="None">
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="models:FileNodeViewModel">
                                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            CornerRadius="8"
                                                            Padding="16"
                                                            Width="200"
                                                            Height="120"
                                                            DoubleTapped="MinimalAsset_DoubleTapped">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            
                                                            <!-- Thumbnail (shown when available and toggle is on) -->
                                                            <Image Grid.Row="0"
                                                                   Source="{Binding Thumbnail}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Stretch="UniformToFill"/>
                                                            
                                                            <!-- Icon (fallback when no thumbnail) -->
                                                            <FontIcon Grid.Row="0" 
                                                                      Glyph="{x:Bind FileIcon, Mode=OneWay}" 
                                                                      FontSize="48"
                                                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                                      HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"
                                                                      Visibility="{Binding IsIconVisible, Converter={StaticResource BoolToVis}}"/>
                                                            
                                                            <!-- Custom Icon (fallback for audio etc) -->
                                                            <Image Grid.Row="0"
                                                                   Width="48" Height="48"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVis}}">
                                                                <Image.Source>
                                                                    <BitmapImage UriSource="{x:Bind CustomIconUri, Mode=OneWay}" DecodePixelWidth="48"/>
                                                                </Image.Source>
                                                            </Image>
                                                            
                                                            <!-- Name -->
                                                            <TextBlock Grid.Row="1" 
                                                                       Text="{x:Bind DisplayName, Mode=OneWay}"
                                                                       FontSize="13" 
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       HorizontalAlignment="Center" 
                                                                       Margin="0,12,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Dashboard View Container (populated from code-behind) -->
            <Grid x:Name="DashboardContainer" Visibility="Collapsed"/>
        </Grid>

        <!-- Settings Sheet Overlay -->
        <Grid x:Name="SettingsOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Visibility="Collapsed">
            <Button Background="Transparent"
                    BorderThickness="0"
                    Click="SettingsBackdrop_Click"/>

            <Border Width="1200"
                    Height="860"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="28"
                    Padding="28">
                <Border.Background>
                    <AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}"
                                  TintOpacity="0.75"
                                  FallbackColor="{ThemeResource SolidBackgroundFillColorBaseBrush}"/>
                </Border.Background>
                <Border.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="36" IsStaggeringEnabled="False"/>
                    </TransitionCollection>
                </Border.Transitions>
                <ContentControl x:Name="SettingsPanelHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#CC000000"
              Visibility="{x:Bind ViewModel.IsLoadingVisibility, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                <ProgressRing IsActive="True" 
                             Width="60" 
                             Height="60" 
                             Foreground="White"/>
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" 
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
