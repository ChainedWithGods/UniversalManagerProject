<UserControl
    x:Class="PakViewer.Controls.TextPreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sticky Metadata Header -->
        <Border x:Name="HeaderBar"
                Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6"
                CornerRadius="8,8,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8A5;" FontSize="14" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HeaderFileName"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="280"/>
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="3"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderExtension"
                                   FontSize="11"
                                   Opacity="0.8"/>
                    </Border>
                    <TextBlock x:Name="HeaderSize"
                               FontSize="11"
                               Opacity="0.6"
                               VerticalAlignment="Center"/>
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="3"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderLineCount"
                                   FontSize="11"
                                   Opacity="0.8"/>
                    </Border>
                    <TextBlock x:Name="HeaderEncoding"
                               FontSize="11"
                               Opacity="0.5"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="SearchToggleButton"
                                  MinWidth="0"
                                  Padding="10,4"
                                  VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Find in file">
                        <FontIcon Glyph="&#xE721;" FontSize="14"/>
                    </ToggleButton>

                    <Button x:Name="CopyAllButton"
                            MinWidth="0"
                            Padding="10,4"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Copy all text">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                    </Button>

                    <Button x:Name="OpenInWindowButton"
                            MinWidth="0"
                            Padding="10,4"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Open full code viewer">
                        <FontIcon Glyph="&#xE740;" FontSize="14"/>
                    </Button>

                    <ToggleButton x:Name="WordWrapToggle"
                                  MinWidth="0"
                                  Padding="10,4"
                                  VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Toggle word wrap">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="WrapIcon" Glyph="&#xE75D;" FontSize="14"/>
                            <TextBlock Text="Wrap" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="SearchBar"
                Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         PlaceholderText="Find in file (Enter for next, use arrows for previous/next)"
                         MinWidth="260"/>

                <ToggleButton x:Name="MatchCaseToggle"
                              Grid.Column="1"
                              MinWidth="0"
                              Padding="10,4"
                              VerticalAlignment="Center"
                              ToolTipService.ToolTip="Match case">
                    <TextBlock Text="Aa" FontSize="12" FontWeight="SemiBold"/>
                </ToggleButton>

                <TextBlock x:Name="SearchResultText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Opacity="0.7"
                           Text="Enter text to find"/>

                <Button x:Name="FindPreviousButton"
                        Grid.Column="3"
                        MinWidth="0"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Find previous">
                    <FontIcon Glyph="&#xE74B;" FontSize="14"/>
                </Button>

                <Button x:Name="FindNextButton"
                        Grid.Column="4"
                        MinWidth="0"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Find next">
                    <FontIcon Glyph="&#xE74C;" FontSize="14"/>
                </Button>

                <Button x:Name="CloseSearchButton"
                        Grid.Column="5"
                        MinWidth="0"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Close search">
                    <FontIcon Glyph="&#xE711;" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                CornerRadius="0,0,8,8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,1,1">
            <controls:WebView2 x:Name="ContentWebView"/>
        </Border>

        <Grid x:Name="LoadingOverlay"
              Grid.Row="2"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <ProgressRing IsActive="True" Width="28" Height="28"/>
                <TextBlock x:Name="LoadingText" Text="Preparing preview..." Opacity="0.6" FontSize="12"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
