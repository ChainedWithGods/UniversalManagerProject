<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <OutputType>WinExe</OutputType>
        <DefaultItemExcludes>$(DefaultItemExcludes);Libs\**;Temp\**;example\**</DefaultItemExcludes>

        <Version>1.1.1.1</Version>
        <AssemblyVersion>1.1.1.1</AssemblyVersion>
        <FileVersion>1.1.1.1</FileVersion>
        <InformationalVersion>1.1.1.1</InformationalVersion>

        <UseWinUI>true</UseWinUI>
        <EnableMsixTooling>true</EnableMsixTooling>
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
        <SelfContained>false</SelfContained>
        <PublishSingleFile>false</PublishSingleFile>

        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>PakViewer</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PlatformTarget>x64</PlatformTarget>
        <Company>Universal Manager Project</Company>
        <Product>PakViewer</Product>
        <Description>PakViewer - Unreal Engine Pak File Viewer</Description>
        <Copyright>Copyright (C) 2026 Universal Mananger Project.</Copyright>

        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <TrimMode>link</TrimMode>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
        <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>

        <ApplicationIcon>Icons\PakViewer.ico</ApplicationIcon>
        <UseRidGraph>true</UseRidGraph>
        <Platforms>AnyCPU;x64</Platforms>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <PublishProfile>win-$(Platform).pubxml</PublishProfile>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        
        <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8620;CS8625;CS8629;CS8631</NoWarn>
    </PropertyGroup>

