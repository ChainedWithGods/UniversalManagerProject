<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PlatformTarget>x64</PlatformTarget>
        <AssemblyName>ModConflictDetector</AssemblyName>
        <Company>Universal Project</Company>
        <Product>ModConflictDetector</Product>
        <Description>ModConflictDetector</Description>
        <Copyright>Copyright (C) Universal Manager Project.</Copyright>
        <Configuration>Release</Configuration>
        <Optimize>true</Optimize>
        <DebugType>none</DebugType>
        <DefaultItemExcludes>$(DefaultItemExcludes);Libs\**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="Libs\CUE4Parse\CUE4Parse\CUE4Parse.csproj" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    </ItemGroup>

</Project>
